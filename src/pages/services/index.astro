---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HandDrawnRule from "../../components/HandDrawnRule.astro";

const pageTitle = "Services | oobCREATIVE";
const description = "Messaging, websites, communication systems, practical AI, campaigns, storytelling, and ongoing communication support from oobCREATIVE.";
---

<BaseLayout title={pageTitle} description={description}>
  <section class="page-hero">
    <div class="site-shell page-hero__copy">
      <p class="eyebrow">Services</p>
      <h1>Clear communication. Practical systems. Human judgment intact.</h1>
      <p class="page-kicker">
        The service is not the starting point. We begin with what needs to become easier to understand, easier to support, or easier to move forward.
      </p>
    </div>
  </section>

  <HandDrawnRule />

  <section class="page-section">
    <div class="site-shell">
      <div class="service-grid">
        <article class="service-card">
          <p class="eyebrow">Message + identity</p>
          <h2>Make the value easier to understand.</h2>
          <p>Positioning, audience clarification, brand and mission messaging, service descriptions, website copy, calls to action, and core narrative development.</p>
        </article>
        <article class="service-card">
          <p class="eyebrow">Websites</p>
          <h2>Make the decision path easier to use.</h2>
          <p>Website architecture, audience pathways, content hierarchy, navigation, copy, visual direction, implementation, and search or AI-discovery foundations.</p>
        </article>
        <article class="service-card">
          <p class="eyebrow">Systems + practical AI</p>
          <h2>Make useful work easier to repeat.</h2>
          <p>Communication workflows, knowledge systems, AI use-case selection, human-review standards, CRM and tool connections, implementation support, and staff guidance.</p>
          <a class="text-link" href="/services/communication-systems-ai/">Explore AI + systems <span aria-hidden="true">→</span></a>
        </article>
        <article class="service-card">
          <p class="eyebrow">Campaigns + launches</p>
          <h2>Make an important moment easier to act on.</h2>
          <p>Campaign messaging, launches, fundraising communication, human-centered storytelling, video and media direction, email, social rollout, and distribution planning.</p>
        </article>
        <article class="service-card">
          <p class="eyebrow">Ongoing support</p>
          <h2>Keep the system useful after launch.</h2>
          <p>Strategy and prioritization, content planning, website updates, campaign support, workflow refinement, vendor coordination, and review before publication.</p>
        </article>
        <article class="service-card">
          <p class="eyebrow">Project recovery</p>
          <h2>Find the next safe decision when something has gone wrong.</h2>
          <p>A bounded review of what exists, what is salvageable, what should stop, and what a phased recovery path could look like without repeating the same opaque process.</p>
        </article>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="page-section">
    <div class="site-shell content-grid">
      <div class="content-grid__aside">
        <p class="eyebrow">How we work</p>
        <h2>Choose how much help you want.</h2>
      </div>
      <div class="content-grid__main">
        <div class="callout">
          <h3>Guided / DIY Assist</h3>
          <p>You do more of the work with structure, templates, feedback, and expert guidance. DIY does not have to mean doing it alone.</p>
        </div>
        <div class="callout">
          <h3>Co-Created / Co-Create</h3>
          <p>We develop the thinking and materials together. Your knowledge remains visible while oobCREATIVE adds structure, outside perspective, and implementation skill.</p>
        </div>
        <div class="callout">
          <h3>Full Implementation / Custom Services</h3>
          <p>oobCREATIVE leads more of the strategy, creation, coordination, and implementation within clear boundaries so you can stay focused on the work you own.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
