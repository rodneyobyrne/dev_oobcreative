---
import BaseLayout from "../layouts/BaseLayout.astro";
import HandDrawnRule from "../components/HandDrawnRule.astro";

const pageTitle = "oobCREATIVE | Go Deeper, Not Louder";
const description =
  "oobCREATIVE helps mission-driven and expert-led organizations make complex work understandable, usable, and easier to support.";
---

<BaseLayout title={pageTitle} description={description}>
  <main>
    <section class="home-hero">
      <div class="site-shell home-hero__inner">
        <div class="home-hero__copy">
          <p class="eyebrow">Human-led strategy and implementation</p>

          <h1>
            Build with clarity.
            <span class="tone-shift">Move with intent.</span>
          </h1>

          <p class="lead">
            oobCREATIVE helps mission-driven and expert-led organizations make
            complex work easier to understand, use, and support.
          </p>

          <div class="action-row">
            <a class="button button--outline" href="/who-we-help/">See How We Help</a>
            <a class="text-link" href="/work/">View the Work <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="home-hero__visual" aria-hidden="true">
          <img
            src="/branding/Mark-black.svg"
            alt=""
            width="520"
            height="360"
          />
          <p class="hand-note">A clear line through complicated work.</p>
        </div>
      </div>
    </section>

    <HandDrawnRule />

    <section class="home-paths" aria-labelledby="paths-heading">
      <div class="site-shell">
        <div class="section-intro">
          <p class="eyebrow">Three ways forward</p>
          <h2 id="paths-heading">
            Start with what needs to become
            <span class="tone-shift">clearer.</span>
          </h2>
        </div>

        <div class="path-grid">
          <article class="path-card">
            <div class="number-circle">01</div>
            <h3>Clarify</h3>
            <p>
              Make valuable work easier to understand, trust, and choose.
            </p>
            <a class="text-link" href="/services/positioning-messaging-websites/">
              Explore this path <span aria-hidden="true">→</span>
            </a>
          </article>

          <HandDrawnRule orientation="vertical" class="path-divider" />

          <article class="path-card">
            <div class="number-circle">02</div>
            <h3>Structure</h3>
            <p>
              Build communication systems, knowledge resources, and practical workflows.
            </p>
            <a class="text-link" href="/services/communication-systems-practical-ai/">
              Explore this path <span aria-hidden="true">→</span>
            </a>
          </article>

          <HandDrawnRule orientation="vertical" class="path-divider" />

          <article class="path-card">
            <div class="number-circle">03</div>
            <h3>Move</h3>
            <p>
              Bring a campaign, launch, website, or important initiative forward.
            </p>
            <a class="text-link" href="/services/campaigns-fundraising-growth/">
              Explore this path <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <HandDrawnRule />

    <section class="home-work" aria-labelledby="work-heading">
      <div class="site-shell">
        <div class="section-heading-row">
          <div>
            <p class="eyebrow">Selected work</p>
            <h2 id="work-heading">
              Strategy made
              <span class="tone-shift">visible.</span>
            </h2>
          </div>
          <a class="text-link" href="/work/">View all work <span aria-hidden="true">→</span></a>
        </div>

        <div class="work-grid">
          <article class="work-item">
            <p class="meta">Rock and Roll Academy Aspen</p>
            <h3>Building the Backline</h3>
            <p>
              Communications and fundraising structure supporting regional nonprofit growth.
            </p>
            <a class="text-link" href="/work/rock-and-roll-academy/">
              View case study <span aria-hidden="true">→</span>
            </a>
          </article>

          <HandDrawnRule orientation="vertical" class="work-divider" />

          <article class="work-item">
            <p class="meta">Everett Health Partners</p>
            <h3>Buyer-Led Growth Platform</h3>
            <p>
              Brand, buyer architecture, website strategy, and product opportunity.
            </p>
            <a class="text-link" href="/work/everett-health-partners/">
              View case study <span aria-hidden="true">→</span>
            </a>
          </article>

          <HandDrawnRule orientation="vertical" class="work-divider" />

          <article class="work-item">
            <p class="meta">Varetto Recovery</p>
            <h3>Recovery Looks Different</h3>
            <p>
              A clear digital experience for an individualized recovery philosophy.
            </p>
            <a class="text-link" href="/work/varetto-recovery/">
              View case study <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <HandDrawnRule />

    <section class="home-cta">
      <div class="site-shell">
        <div class="cta-panel">
          <div>
            <p class="eyebrow">What needs to move?</p>
            <h2>Ready to make the work clearer?</h2>
          </div>
          <a class="button button--primary" href="/start-a-conversation/">
            Start a Conversation
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
