---
import BaseLayout from "../layouts/BaseLayout.astro";
import HandDrawnRule from "../components/HandDrawnRule.astro";

const pageTitle = "Practical AI Integration for Small Teams | oobCREATIVE";
const description =
  "oobCREATIVE helps small businesses, nonprofits, and expert-led teams make AI useful inside real workflows while strengthening the communication and systems around the work.";
---

<BaseLayout title={pageTitle} description={description}>
  <section class="home-hero home-hero--answer-first">
    <div class="site-shell home-hero__inner">
      <div class="home-hero__copy">
        <p class="eyebrow">Practical AI + communication systems</p>
        <h1>
          Make AI useful inside the business
          <span class="tone-shift">you already have.</span>
        </h1>
        <p class="lead">
          Start with the work, not the tool. oobCREATIVE helps small businesses,
          nonprofits, and expert-led teams decide what to automate, what to connect,
          what should stay human, and how to make the whole system easier to understand
          and maintain.
        </p>
        <div class="action-row">
          <a class="button button--primary" href="/start-here/">Find the first useful move</a>
          <a class="text-link" href="/resources/ai-workflow-map/">Get the free workflow map <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note">You do not need an AI transformation plan to start. One useful workflow is enough.</p>
      </div>

      <div class="home-hero__visual" aria-hidden="true">
        <div class="hero-box-stage">
          <img src="/branding/oob-box-loader.svg" alt="" width="430" height="330" />
          <p class="hand-note">Useful technology should reduce friction, not create another system to babysit.</p>
        </div>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="situation-section" aria-labelledby="situation-heading">
    <div class="site-shell">
      <div class="section-intro section-intro--compact">
        <p class="eyebrow">Start with what is happening today</p>
        <h2 id="situation-heading">Which version feels most familiar?</h2>
        <p class="section-copy">
          Choose one. You will get a useful first move before we ask you for anything.
        </p>
      </div>

      <div class="situation-picker" data-situation-picker>
        <div class="situation-options" role="group" aria-label="Choose the situation that feels most familiar">
          <button class="situation-option" type="button" data-situation="ai" aria-pressed="false">
            <span class="situation-option__number">01</span>
            <strong>We use AI, but it is not really part of the work.</strong>
            <span>There are subscriptions, experiments, and good ideas. The useful workflow is still missing.</span>
          </button>
          <button class="situation-option" type="button" data-situation="knowledge" aria-pressed="false">
            <span class="situation-option__number">02</span>
            <strong>Too much knowledge still lives in people&apos;s heads.</strong>
            <span>Work slows down because context, approvals, and standards have to be reconstructed every time.</span>
          </button>
          <button class="situation-option" type="button" data-situation="clarity" aria-pressed="false">
            <span class="situation-option__number">03</span>
            <strong>People do not understand what we do as quickly as they should.</strong>
            <span>The expertise is real. The website, message, or decision path is making people work too hard to see it.</span>
          </button>
        </div>

        <div class="situation-response" data-situation-response aria-live="polite">
          <p class="eyebrow">A useful first move</p>
          <h3 data-response-title>Pick the situation that feels closest.</h3>
          <p data-response-copy>
            We will show you what we would examine first, what kind of proof is relevant, and a free resource you can use without booking a call.
          </p>
          <div class="response-actions" data-response-actions></div>
        </div>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="answer-section" aria-labelledby="answers-heading">
    <div class="site-shell">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Questions underneath the AI question</p>
          <h2 id="answers-heading">Most teams are not actually asking for more AI.</h2>
        </div>
        <a class="text-link" href="/questions/">See the extended FAQ <span aria-hidden="true">→</span></a>
      </div>

      <div class="answer-grid">
        <article class="answer-card">
          <p class="meta">Tool choice</p>
          <h3>Do we need ChatGPT, Claude, Gemini, Copilot, Zapier, n8n, MCP, or an agent?</h3>
          <p>Usually not all of them. Start by defining the job, the information involved, and the human decision that still needs an owner. The tool choice gets much easier after that.</p>
        </article>
        <article class="answer-card">
          <p class="meta">Integration</p>
          <h3>Can AI work with the software and information we already use?</h3>
          <p>Often, yes. The real question is whether the connection creates a maintainable workflow, respects permissions, and makes the work simpler rather than merely more automated.</p>
        </article>
        <article class="answer-card">
          <p class="meta">Human responsibility</p>
          <h3>What should we automate, and what should stay human?</h3>
          <p>Automate repeatable support around judgment before automating judgment itself. High-consequence decisions, sensitive communication, and accountability should keep visible human ownership.</p>
        </article>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="proof-section" aria-labelledby="proof-heading">
    <div class="site-shell">
      <div class="section-intro">
        <p class="eyebrow">Proof in context</p>
        <h2 id="proof-heading">The technology is new. The underlying work is not.</h2>
        <p class="section-copy">
          oobCREATIVE has spent years making complex work easier to understand, organize, communicate, and support. AI adds a new layer to that responsibility. It does not replace the fundamentals.
        </p>
      </div>

      <div class="proof-grid">
        <article class="proof-card proof-card--feature">
          <p class="meta">Mind Springs Health / West Springs Hospital</p>
          <h3>Communication systems under real organizational pressure</h3>
          <p>
            Executive, board, staff, recruiting, crisis, campaign, and public-facing communication across a multi-community behavioral-health organization, including website channels, reusable staff resources, and audience-sensitive messaging.
          </p>
          <a class="text-link" href="/work/#mind-springs">See the work context <span aria-hidden="true">→</span></a>
        </article>
        <article class="proof-card">
          <p class="meta">Everett Health Partners</p>
          <h3>Audience architecture turned into a consulting website</h3>
          <p>Buyer segmentation, positioning, service pathways, website architecture, content, design, implementation, and ongoing managed support.</p>
          <a class="text-link" href="/work/#everett">See the work context <span aria-hidden="true">→</span></a>
        </article>
        <article class="proof-card">
          <p class="meta">Rock and Roll Academy Aspen</p>
          <h3>One small nonprofit, many communication responsibilities</h3>
          <p>Web, email, fundraising, campaigns, programs, sponsorship communication, storytelling, and ongoing support for a growing youth-music organization.</p>
          <a class="text-link" href="/work/#rraa">See the work context <span aria-hidden="true">→</span></a>
        </article>
        <article class="proof-card">
          <p class="meta">oobCREATIVE R&amp;D</p>
          <h3>Building tools that return value while they learn</h3>
          <p>The oobSKILLS Audience Review and oobDISCOVERY intake systems explore how structured questions, audience intelligence, and useful outputs can work together without turning the experience into a sales form.</p>
          <a class="text-link" href="/work/#rd">See the capability work <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="resource-section" aria-labelledby="resources-heading">
    <div class="site-shell">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Take something useful with you</p>
          <h2 id="resources-heading">No email gate required.</h2>
        </div>
        <a class="text-link" href="/resources/">Browse free resources <span aria-hidden="true">→</span></a>
      </div>

      <div class="resource-grid">
        <a class="resource-card" href="/resources/ai-workflow-map/">
          <span class="resource-card__type">Printable map</span>
          <h3>AI Workflow Starter Map</h3>
          <p>Find one task worth improving, map the information and decisions around it, then decide where AI actually belongs.</p>
          <span class="text-link">Open the map <span aria-hidden="true">→</span></span>
        </a>
        <a class="resource-card" href="/questions/#tools">
          <span class="resource-card__type">Plain-language guide</span>
          <h3>The Tool Confusion Translator</h3>
          <p>A simple way to separate assistants, automations, agents, APIs, MCP, and integration platforms without becoming a software engineer.</p>
          <span class="text-link">Translate the stack <span aria-hidden="true">→</span></span>
        </a>
        <a class="resource-card" href="/questions/#human">
          <span class="resource-card__type">Decision guide</span>
          <h3>What Should Stay Human?</h3>
          <p>A practical test for deciding where automation supports judgment and where visible human ownership should remain.</p>
          <span class="text-link">Use the guide <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="home-cta">
    <div class="site-shell">
      <div class="cta-panel">
        <div>
          <p class="eyebrow">Go deeper, not louder.</p>
          <h2>Bring one messy workflow. We can start there.</h2>
          <p>You do not need to know which AI tool you need before the conversation.</p>
        </div>
        <a class="button button--primary" href="/start-a-conversation/">Talk through a workflow</a>
      </div>
    </div>
  </section>

  <script>
    const picker = document.querySelector('[data-situation-picker]');

    if (picker) {
      const responseTitle = picker.querySelector('[data-response-title]');
      const responseCopy = picker.querySelector('[data-response-copy]');
      const responseActions = picker.querySelector('[data-response-actions]');
      const options = Array.from(picker.querySelectorAll('[data-situation]'));

      const responses = {
        ai: {
          title: 'Choose one recurring job before choosing another tool.',
          copy: 'Map what starts the job, what information it needs, where judgment happens, and what a good finished result looks like. Then test the smallest useful AI-supported step inside that flow.',
          actions: [
            ['Use the free workflow map', '/resources/ai-workflow-map/'],
            ['Explore practical AI + systems', '/services/communication-systems-ai/']
          ]
        },
        knowledge: {
          title: 'Make the missing context visible before automating it.',
          copy: 'Look for the instructions, standards, decisions, and approvals people keep reconstructing from memory. That is usually the first knowledge layer worth organizing for people and AI alike.',
          actions: [
            ['See communication systems work', '/services/communication-systems-ai/#knowledge'],
            ['See related proof', '/work/#mind-springs']
          ]
        },
        clarity: {
          title: 'Fix the decision path before producing more content.',
          copy: 'Identify who is trying to understand the work, what they need to decide, and where the current website or message makes that decision harder. Better architecture often does more than more volume.',
          actions: [
            ['See the broader service approach', '/services/'],
            ['See audience-led website work', '/work/#everett']
          ]
        }
      };

      options.forEach((option) => {
        option.addEventListener('click', () => {
          const key = option.getAttribute('data-situation');
          const response = responses[key];
          if (!response || !responseTitle || !responseCopy || !responseActions) return;

          options.forEach((item) => {
            const active = item === option;
            item.classList.toggle('is-selected', active);
            item.setAttribute('aria-pressed', active ? 'true' : 'false');
          });

          responseTitle.textContent = response.title;
          responseCopy.textContent = response.copy;
          responseActions.innerHTML = response.actions
            .map(([label, href], index) => `<a class="${index === 0 ? 'button button--ink-blue' : 'text-link'}" href="${href}">${label}${index === 0 ? '' : ' <span aria-hidden="true">→</span>'}</a>`)
            .join('');
        });
      });
    }
  </script>
</BaseLayout>
