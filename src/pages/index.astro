---
import BaseLayout from "../layouts/BaseLayout.astro";
import HandDrawnRule from "../components/HandDrawnRule.astro";

const pageTitle = "Small Business AI, Workflow & Communication Help | oobCREATIVE";
const description =
  "Practical help for small businesses and thoughtful teams asking how to use AI, improve workflows, clarify communication, and keep control without adding more complexity.";

const answerCards = [
  {
    question: "Do I need an AI consultant, IT, a developer, or can we do this ourselves?",
    answer:
      "Start with the decision, not the job title. If the work is mostly about understanding a process, choosing a sensible use of AI, or building a bounded first version, you may not need a traditional technical project. Security, infrastructure, complex integrations, regulated data, and production-critical systems can change that answer.",
    personas: "Decision + control",
  },
  {
    question: "What can AI actually take off my plate?",
    answer:
      "Look first for repeated support work around judgment: gathering information, organizing context, drafting, comparing, routing, summarizing, or preparing a decision. The best first use is usually a job you already understand well enough to know when the result is wrong.",
    personas: "Time + bottlenecks",
  },
  {
    question: "Can we build this ourselves now, or do we still need a developer?",
    answer:
      "A growing class of prototypes, internal tools, small apps, forms, knowledge utilities, and workflow helpers can now be built or tested by capable non-developers using AI-assisted tools. The question is not whether developers disappeared. It is where professional development becomes warranted.",
    personas: "Possibility + cost",
  },
  {
    question: "How do I use AI without making more work for myself?",
    answer:
      "Do not start by collecting tools. Pick one recurring job, define what good looks like, decide where a person still reviews the work, and test the smallest useful improvement. If the setup creates more maintenance than relief, it is not helping yet.",
    personas: "Friction + simplicity",
  },
  {
    question: "What should I never hand over to AI?",
    answer:
      "Keep visible human responsibility around high-consequence decisions, sensitive relationships, ambiguous judgment, private information, and anything where trust depends on knowing a person is accountable. AI can support those decisions without quietly becoming the decision-maker.",
    personas: "Trust + responsibility",
  },
];

const capabilities = [
  {
    label: "AI, workflow + business systems",
    title: "Make useful work easier without building a second job around the technology.",
    copy: "Map the work, organize the information, choose what should connect, decide what should stay human, and build only what produces a useful change.",
  },
  {
    label: "Websites + digital experiences",
    title: "Make it easier for people to understand, decide, and act.",
    copy: "Audience pathways, information architecture, content hierarchy, website strategy, implementation, and digital experiences that reflect how the business actually works.",
  },
  {
    label: "Brand, messaging + audience",
    title: "Make the value easier to see without flattening what makes it valuable.",
    copy: "Positioning, audience understanding, messaging systems, identity direction, service language, and communication structure for complex or expert-led work.",
  },
  {
    label: "Campaigns, media + communications",
    title: "Give an important idea enough structure to move through the world.",
    copy: "Campaign strategy, launches, fundraising communication, video and media direction, content systems, storytelling, and coordinated rollout support.",
  },
];
---

<BaseLayout title={pageTitle} description={description}>
  <section class="operator-hero" id="review" aria-labelledby="home-title">
    <div class="site-shell operator-hero__grid">
      <div class="operator-hero__copy">
        <p class="eyebrow">Go deeper, not louder.</p>
        <h1 id="home-title">You know some of this work should be <span class="ink-blue">easier.</span></h1>
        <p class="lead">
          AI, workflows, websites, and communication systems can help. But the useful place to start is not the technology. It is the work that keeps demanding more time, attention, or explanation than it should.
        </p>
        <p class="scribble-note">Get more control without making the work harder.</p>
        <p class="hero-trust">Start with one question. Get a useful first interpretation. No email required.</p>
      </div>

      <div class="review-card" data-review>
        <div class="review-card__header">
          <div>
            <p class="eyebrow ink-blue">Your first move</p>
            <h2>What feels closest right now?</h2>
          </div>
          <span class="review-card__marker" aria-hidden="true">01</span>
        </div>

        <div class="review-options" role="group" aria-label="Choose what feels closest right now">
          <button class="review-option" type="button" data-review-key="opportunity" aria-pressed="false">
            <span class="review-option__dot" aria-hidden="true"></span>
            <span>I know there are opportunities here, and I don’t want to miss the useful ones.</span>
          </button>
          <button class="review-option" type="button" data-review-key="friction" aria-pressed="false">
            <span class="review-option__dot" aria-hidden="true"></span>
            <span>I’m tired of work that feels harder than it should.</span>
          </button>
          <button class="review-option" type="button" data-review-key="boundaries" aria-pressed="false">
            <span class="review-option__dot" aria-hidden="true"></span>
            <span>My team is already using AI, and I’m not sure where the boundaries should be.</span>
          </button>
          <button class="review-option" type="button" data-review-key="build" aria-pressed="false">
            <span class="review-option__dot" aria-hidden="true"></span>
            <span>I have ideas we’ve always assumed would be too expensive or technical to build.</span>
          </button>
          <button class="review-option" type="button" data-review-key="control" aria-pressed="false">
            <span class="review-option__dot" aria-hidden="true"></span>
            <span>I want more control without another system to manage.</span>
          </button>
        </div>

        <div class="review-response" data-review-response aria-live="polite">
          <p class="review-response__label">A useful first read</p>
          <h3 data-review-title>Choose the one that sounds most like your situation.</h3>
          <p data-review-copy>
            We’ll use the answer to separate what is worth understanding, what may be delegated, what should stay human, and what may not be worth worrying about yet.
          </p>
          <a class="text-link" href="#answers" data-review-link>See the questions people ask next <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="editorial-section" id="answers" aria-labelledby="answers-title">
    <div class="site-shell">
      <div class="section-heading-row section-heading-row--top">
        <div>
          <p class="eyebrow ink-blue">Useful answers</p>
          <h2 id="answers-title">Questions people ask when the technology becomes a business decision.</h2>
        </div>
        <p class="section-side-note">The short answer lives here. Deeper pages only earn their place when they add real depth.</p>
      </div>

      <div class="answer-list">
        {answerCards.map((item, index) => (
          <article class:list={["answer-row", index === 0 && "answer-row--feature"]}>
            <div class="answer-row__meta">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span>{item.personas}</span>
            </div>
            <div class="answer-row__content">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="answer-next">
        <p class="signal-note">Next questions: Which AI tool do I actually need? How much do I need to understand myself? What information should I never put into AI?</p>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="editorial-section" id="services" aria-labelledby="services-title">
    <div class="site-shell">
      <div class="section-heading-row section-heading-row--top">
        <div>
          <p class="eyebrow">What oobCREATIVE helps with</p>
          <h2 id="services-title">The service comes after we understand what needs to get easier.</h2>
        </div>
        <a class="text-link" href="/services/">See the service overview <span aria-hidden="true">→</span></a>
      </div>

      <div class="capability-grid">
        {capabilities.map((item, index) => (
          <article class="capability-block">
            <p class="capability-block__number">0{index + 1}</p>
            <p class="eyebrow ink-blue">{item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="editorial-section work-section" id="work" aria-labelledby="work-title">
    <div class="site-shell work-layout">
      <div>
        <p class="eyebrow ink-blue">Work</p>
        <h2 id="work-title">The technology changes. The underlying problems are familiar.</h2>
        <p class="section-copy">
          oobCREATIVE work often sits where complex information, audience decisions, communication, technology, and execution overlap. Detailed client proof and outcomes will only be published after they are cleared for public use.
        </p>
      </div>

      <div class="work-problem-list" aria-label="Types of work">
        <div>
          <span>01</span>
          <p><strong>Audience architecture</strong><br />Turning different buyer concerns into a decision path people can actually use.</p>
        </div>
        <div>
          <span>02</span>
          <p><strong>Communication systems</strong><br />Making complex work easier to explain, repeat, review, and support.</p>
        </div>
        <div>
          <span>03</span>
          <p><strong>Discovery + knowledge tools</strong><br />Using structured questions to return value while gathering better context.</p>
        </div>
        <div>
          <span>04</span>
          <p><strong>Digital experiences</strong><br />Connecting message, structure, interface, and implementation instead of treating the website as a decoration layer.</p>
        </div>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="editorial-section participation-section" aria-labelledby="participation-title">
    <div class="site-shell">
      <div class="section-heading-row section-heading-row--top">
        <div>
          <p class="eyebrow">Ways to work together</p>
          <h2 id="participation-title">You choose how much help is useful.</h2>
        </div>
        <p class="section-side-note">The goal is control without turning the solution into another thing you have to babysit.</p>
      </div>

      <div class="participation-grid">
        <article>
          <p class="eyebrow ink-blue">DIY Assist</p>
          <h3>You do more of the work. You do not have to figure it out alone.</h3>
          <p>Use oobCREATIVE for structure, questions, feedback, research, decision support, and the occasional technical or creative assist.</p>
        </article>
        <article>
          <p class="eyebrow ink-blue">Co-Create</p>
          <h3>Build it together without losing your judgment inside the process.</h3>
          <p>Your knowledge stays visible while oobCREATIVE adds outside perspective, structure, creative development, and implementation skill.</p>
        </article>
        <article>
          <p class="eyebrow ink-blue">Custom Services</p>
          <h3>Let oobCREATIVE carry more of the execution while you stay involved where you should.</h3>
          <p>The level of technical detail you need to manage should match the decisions you are actually responsible for, not somebody else’s preferred workflow.</p>
        </article>
      </div>
    </div>
  </section>

  <HandDrawnRule />

  <section class="editorial-section about-section" id="about" aria-labelledby="about-title">
    <div class="site-shell about-layout">
      <div class="about-mark" aria-hidden="true">
        <img src="/branding/Mark-black.svg" alt="" width="360" height="280" />
      </div>
      <div>
        <p class="eyebrow ink-blue">Why oobCREATIVE</p>
        <h2 id="about-title">Technology is useful when people can still see what they are doing with it.</h2>
        <p class="lead lead--compact">
          Rodney O’Byrne works across information architecture, communication, media, audience understanding, workflow, and technology. The recurring question is not “What can the tool do?” It is “What are we trying to accomplish, what judgment is involved, and where can technology make the system better without making the people smaller?”
        </p>
        <p class="scribble-note scribble-note--small">Keep humans human.</p>
      </div>
    </div>
  </section>

  <section class="talk-band" id="talk" aria-labelledby="talk-title">
    <div class="site-shell talk-band__grid">
      <div>
        <p class="eyebrow">Talk</p>
        <h2 id="talk-title">Bring the part that keeps nagging at you.</h2>
      </div>
      <div>
        <p>You do not need to know whether it is an AI problem, a workflow problem, a website problem, or something else before you ask.</p>
        <a class="button button--paper" href="mailto:hello@oobcreative.com">hello@oobcreative.com</a>
        <p class="talk-band__note">No pressure to arrive with the right vocabulary.</p>
      </div>
    </div>
  </section>

  <script>
    const review = document.querySelector('[data-review]');

    if (review) {
      const options = Array.from(review.querySelectorAll('[data-review-key]'));
      const title = review.querySelector('[data-review-title]');
      const copy = review.querySelector('[data-review-copy]');
      const link = review.querySelector('[data-review-link]');

      const responses = {
        opportunity: {
          title: 'You probably do not need to understand every new tool.',
          copy: 'A better first question is which parts of your business are expensive, repetitive, hard to explain, or unnecessarily dependent on one person. That gives us somewhere useful to investigate before buying anything.',
          link: 'See where small businesses usually start',
        },
        friction: {
          title: 'The friction is useful information.',
          copy: 'Pick one recurring job that irritates you because it should be easier by now. Map what starts it, what information it needs, where judgment happens, and what “done well” looks like. That is a much better AI brief than “we need automation.”',
          link: 'See what AI can actually take off your plate',
        },
        boundaries: {
          title: 'You do not have to shut experimentation down to create boundaries.',
          copy: 'Start by identifying sensitive information, high-consequence decisions, required human review, and places where a generic answer could damage trust. Your team can explore inside a boundary they understand.',
          link: 'See what should stay human',
        },
        build: {
          title: 'Some ideas deserve to be reconsidered now.',
          copy: 'AI-assisted development has changed the cost of testing many small tools, internal apps, forms, and workflow ideas. The first decision is whether a useful first version can be built safely before assuming a full development project.',
          link: 'See when you may still need a developer',
        },
        control: {
          title: 'Control does not mean becoming the system administrator.',
          copy: 'You should understand enough to make good decisions, know what information the system uses, see where people remain responsible, and be able to change direction without turning the technology into another category of work.',
          link: 'See how to use AI without making more work',
        },
      };

      options.forEach((option) => {
        option.addEventListener('click', () => {
          const key = option.getAttribute('data-review-key');
          const response = responses[key];
          if (!response || !title || !copy || !link) return;

          options.forEach((item) => {
            const selected = item === option;
            item.classList.toggle('is-selected', selected);
            item.setAttribute('aria-pressed', selected ? 'true' : 'false');
          });

          title.textContent = response.title;
          copy.textContent = response.copy;
          link.innerHTML = `${response.link} <span aria-hidden="true">→</span>`;
        });
      });
    }
  </script>
</BaseLayout>
