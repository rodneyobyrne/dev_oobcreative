---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="oobCREATIVE"
  description="The development foundation for the new oobCREATIVE website."
  noindex={true}
>
  <section class="section">
    <div class="container foundation">
      <div>
        <p class="eyebrow">Development foundation</p>

        <h1>oobCREATIVE</h1>

        <p class="lede">
          The global layout, navigation, footer, responsive styles, and
          metadata structure are now connected.
        </p>
      </div>

      <aside class="status-panel">
        <h2>Foundation status</h2>

        <ul>
          <li>Astro project active</li>
          <li>Global layout connected</li>
          <li>Responsive navigation connected</li>
          <li>Footer connected</li>
          <li>Production build ready for testing</li>
        </ul>

        <p>
          Final brand design and approved homepage content come next.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .foundation {
    display: grid;
    min-height: 65vh;
    align-items: center;
    grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.75fr);
    gap: var(--space-7);
  }

  .status-panel {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .status-panel h2 {
    margin-bottom: var(--space-4);
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }

  .status-panel ul {
    margin: 0 0 var(--space-4);
    padding-left: 1.2rem;
  }

  .status-panel li + li {
    margin-top: 0.5rem;
  }

  .status-panel p {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (max-width: 48rem) {
    .foundation {
      min-height: auto;
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>