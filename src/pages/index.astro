---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContentSection from '../components/ContentSection.astro';
import CallToAction from '../components/CallToAction.astro';
---

<BaseLayout
  title="oobCREATIVE"
  description="Strategy, content, design, and digital production for complicated communication problems."
  noindex={true}
>
  <PageHero
    eyebrow="Independent strategy and production"
    heading="Make the complicated part usable."
    body="oobCREATIVE helps organizations organize ideas, clarify their message, and turn the work into useful digital experiences."
    primaryLabel="Start a conversation"
    primaryHref="/contact/"
    secondaryLabel="Review the services"
    secondaryHref="/services/"
  />

  <ContentSection
    eyebrow="Foundation"
    heading="Strategy and execution should connect."
    body="The website framework is now built around reusable components rather than one-off page layouts."
    surface={true}
    narrow={true}
  >
    <p>
      Content can be developed separately, reviewed normally, and then
      applied to the website through a controlled update process.
    </p>

    <p>
      Final positioning, design decisions, services, and portfolio content
      will replace this temporary foundation copy.
    </p>
  </ContentSection>

  <CallToAction
    eyebrow="Development status"
    heading="The reusable website system is active."
    body="The next stage will establish the visual design system and begin the approved homepage."
    primaryLabel="Start a conversation"
    primaryHref="/contact/"
  />
</BaseLayout>