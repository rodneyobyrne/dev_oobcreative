---
interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  heading,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta">
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}

        <h2>{heading}</h2>

        <p>{body}</p>
      </div>

      <div class="cta-actions">
        <a class="button" href={primaryHref}>
          {primaryLabel}
        </a>

        {
          secondaryLabel && secondaryHref && (
            <a class="button button-secondary" href={secondaryHref}>
              {secondaryLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    align-items: end;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-medium);
    background: var(--color-text);
    color: var(--color-background);
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6);
  }

  h2 {
    max-width: 15ch;
  }

  p:not(.eyebrow) {
    max-width: 42rem;
    margin-top: var(--space-3);
    margin-bottom: 0;
    color: color-mix(
      in srgb,
      var(--color-background) 75%,
      transparent
    );
    font-size: 1.15rem;
  }

  .eyebrow {
    color: inherit;
    opacity: 0.7;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta .button {
    border-color: var(--color-background);
    background: var(--color-background);
    color: var(--color-text);
  }

  .cta .button:hover {
    background: transparent;
    color: var(--color-background);
  }

  .cta .button-secondary {
    background: transparent;
    color: var(--color-background);
  }

  .cta .button-secondary:hover {
    background: var(--color-background);
    color: var(--color-text);
  }

  @media (max-width: 48rem) {
    .cta {
      align-items: start;
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 32rem) {
    .cta-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .cta-actions .button {
      width: 100%;
    }
  }
</style>