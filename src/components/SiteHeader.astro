---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/who-we-help/', label: 'Who We Help' },
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="site-shell site-header__inner">
    <a class="brand-lockup" href="/" aria-label="oobCREATIVE home">
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="/branding/oob_horiz-flat-dark.png" />
        <img src="/branding/oob_horiz-flat-lite.png" alt="oobCREATIVE" width="286" height="68" />
      </picture>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a class="button button--outline" href="/start-a-conversation/">Start a Conversation</a>
    </nav>
  </div>
</header>
