---
interface NavItem {
  href: string;
  label: string;
}

const navItems: NavItem[] = [
  { href: "/who-we-help/", label: "Who We Help" },
  { href: "/services/", label: "Services" },
  { href: "/work/", label: "Work" },
  { href: "/about/", label: "About" },
];
---

<header class="site-header">
  <div class="site-shell site-header__inner">
    <a class="site-header__mark" href="/" aria-label="oobCREATIVE home">
      <img
        src="/branding/Mark.svg"
        alt=""
        width="76"
        height="52"
      />
    </a>

    <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}

      <a class="site-nav__cta" href="/start-a-conversation/">
        Start a Conversation
      </a>
    </nav>

    <details class="site-nav-mobile">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav aria-label="Mobile navigation">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}

        <a class="site-nav__cta" href="/start-a-conversation/">
          Start a Conversation
        </a>
      </nav>
    </details>
  </div>
</header>

<style is:global>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2000;
    padding: 0.75rem 1rem;
    background: #ffffff;
    color: #111111;
    border: 1px solid #111111;
    transform: translateY(-160%);
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #000000;
  }

  .site-header::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -5px;
    left: 0;
    height: 10px;
    background: #111111;
    clip-path: polygon(
      0 34%,
      6% 28%,
      13% 39%,
      21% 31%,
      29% 42%,
      38% 30%,
      47% 40%,
      57% 29%,
      67% 41%,
      77% 31%,
      87% 39%,
      94% 28%,
      100% 35%,
      100% 66%,
      92% 61%,
      84% 70%,
      74% 62%,
      64% 71%,
      54% 61%,
      44% 70%,
      34% 62%,
      24% 71%,
      14% 61%,
      6% 69%,
      0 64%
    );
    pointer-events: none;
  }

  .site-header__inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-header__mark {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .site-header__mark img {
    display: block;
    width: auto;
    height: 48px;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.4rem, 2.8vw, 2.8rem);
  }

  .site-nav a {
    color: #ffffff;
    font-size: 0.76rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-nav a:not(.site-nav__cta) {
    position: relative;
    padding-block: 0.4rem;
  }

  .site-nav a:not(.site-nav__cta)::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 160ms ease;
  }

  .site-nav a:not(.site-nav__cta):hover::after,
  .site-nav a:not(.site-nav__cta):focus-visible::after {
    transform: scaleX(1);
  }

  .site-nav__cta {
    padding: 1rem 1.4rem;
    background: #8f8f8f;
    color: #ffffff;
    border: 1px solid #8f8f8f;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .site-nav__cta:visited {
    color: #ffffff;
  }

  .site-nav__cta:hover,
  .site-nav__cta:focus-visible,
  .site-nav__cta:visited:hover,
  .site-nav__cta:visited:focus-visible {
    background: #ffffff;
    color: #111111;
    border-color: #ffffff;
  }

  .site-nav-mobile {
    display: none;
    position: relative;
  }

  .site-nav-mobile summary {
    width: 44px;
    height: 44px;
    display: grid;
    align-content: center;
    gap: 5px;
    padding: 0.75rem;
    cursor: pointer;
    list-style: none;
  }

  .site-nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .site-nav-mobile summary span {
    display: block;
    height: 1px;
    background: #ffffff;
  }

  .site-nav-mobile nav {
    position: absolute;
    top: calc(100% + 1rem);
    right: 0;
    width: min(82vw, 320px);
    padding: 1.25rem;
    background: #000000;
    border: 1px solid #444444;
  }

  .site-nav-mobile nav a {
    display: block;
    padding: 0.8rem 0;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-nav-mobile nav .site-nav__cta {
    margin-top: 0.75rem;
    padding: 1rem;
    text-align: center;
  }

  @media (max-width: 760px) {
    .site-header__inner {
      min-height: 72px;
    }

    .site-header__mark img {
      height: 42px;
    }

    .site-nav--desktop {
      display: none;
    }

    .site-nav-mobile {
      display: block;
    }
  }
</style>