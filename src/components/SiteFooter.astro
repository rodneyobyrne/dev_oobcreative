---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-shell site-footer__main">
    <div class="site-footer__brand">
      <img
        src="/branding/oob_horiz-flat-dark.png"
        alt="oobCREATIVE"
        width="230"
        height="53"
        loading="lazy"
      />
      <p>Go deeper, not louder.</p>
      <p class="site-footer__descriptor">Practical AI, communication systems, websites, and human-centered implementation.</p>
    </div>

    <div class="site-footer__links">
      <div>
        <p class="footer-label">Explore</p>
        <a href="/start-here/">Start Here</a>
        <a href="/services/communication-systems-ai/">AI + Systems</a>
        <a href="/work/">Work</a>
        <a href="/resources/">Resources</a>
        <a href="/about/">About</a>
      </div>

      <div>
        <p class="footer-label">Connect</p>
        <a href="/start-a-conversation/">Talk Through a Workflow</a>
        <a href="mailto:hello@oobcreative.com">hello@oobcreative.com</a>
      </div>
    </div>
  </div>

  <div class="site-footer__bar">
    <div class="site-shell site-footer__bar-inner">
      <span>© 2018–{year} oobCREATIVE. All rights reserved.</span>
      <span>Roaring Fork Valley, Colorado</span>
      <a href="/privacy-policy/">Privacy Policy</a>
    </div>
  </div>
</footer>
