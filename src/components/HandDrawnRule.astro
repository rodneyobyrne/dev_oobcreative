---
interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string;
  decorative?: boolean;
}

const {
  orientation = "horizontal",
  class: className = "",
  decorative = true,
} = Astro.props;

const isVertical = orientation === "vertical";
---

<span
  class:list={[
    "hand-rule",
    isVertical ? "hand-rule--vertical" : "hand-rule--horizontal",
    className,
  ]}
  aria-hidden={decorative ? "true" : undefined}
>
  <span class="hand-rule__stroke hand-rule__stroke--one"></span>

  {!isVertical && (
    <span class="hand-rule__stroke hand-rule__stroke--two"></span>
  )}
</span>
