---
const pathname = Astro.url.pathname;

const navigation = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Work', href: '/work/' },
  { label: 'About', href: '/about/' },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="oobCREATIVE home">
      <span class="brand-oob">oob</span><span>CREATIVE</span>
    </a>

    <nav class="desktop-navigation" aria-label="Primary navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="button header-action" href="/contact/">
      Start a conversation
    </a>

    <details class="mobile-menu">
      <summary>Menu</summary>

      <nav aria-label="Mobile navigation">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/contact/">Contact</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .header-inner {
    position: relative;
    display: flex;
    min-height: 5rem;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    margin-right: auto;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .brand-oob {
    font-weight: 500;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-muted);
    font-weight: 650;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .header-action {
    min-height: 2.5rem;
    font-size: 0.9rem;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 48rem) {
    .desktop-navigation,
    .header-action {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    summary {
      cursor: pointer;
      font-weight: 700;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu nav {
      position: absolute;
      top: calc(100% + 1px);
      right: 0;
      left: 0;
      padding: 1.5rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-surface);
    }

    .mobile-menu ul {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .mobile-menu a {
      display: block;
      padding-block: 0.75rem;
    }
  }
</style>